<?xml version="1.0"?>
<package format="3">
  <name>nav_interface_adapter</name>
  <version>0.1.0</version>
  <description>Normalize external odometry and point cloud sources for the navigation stack.</description>
  <maintainer email="hit.zhangwf@gmail.com">waney</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>livox_ros_driver2</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_sensor_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
