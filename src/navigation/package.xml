<?xml version="1.0"?>
<package format="3">
  <name>navigation</name>
  <version>0.1.0</version>
  <description>Nav2 wrapper for planner, controller, costmap, and STVL obstacle avoidance.</description>
  <maintainer email="hit.zhangwf@gmail.com">waney</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>spatio_temporal_voxel_layer</exec_depend>
  <exec_depend>nav2_mppi_controller</exec_depend>
  <exec_depend>agv_mpc_controller</exec_depend>
  <exec_depend>nav_goal_regenerator</exec_depend>
  <exec_depend>nav2_smac_planner</exec_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
