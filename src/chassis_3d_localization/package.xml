<?xml version="1.0"?>
<package format="3">
  <name>chassis_3d_localization</name>
  <version>0.1.0</version>
  <description>3D scan-to-map localization for the chassis navigation stack.</description>
  <maintainer email="hit.zhangwf@gmail.com">waney</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>chassis_localization_msgs</depend>
  <build_depend>eigen</build_depend>
  <depend>geometry_msgs</depend>
  <build_depend>libpcl-all-dev</build_depend>
  <depend>message_filters</depend>
  <depend>nav_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>rclcpp</depend>
  <depend>scan_registration</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>libpcl-all-dev</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
